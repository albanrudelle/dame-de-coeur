# URL publique du site (sitemap, partage sur les réseaux). À régler dans Vercel avec votre vrai domaine.
NEXT_PUBLIC_SITE_URL=https://domaine-dame-de-coeur.fr

# ── Formulaire de contact (obligatoire pour recevoir les demandes) ──
# 1. Créez un compte sur resend.com puis une clé API
RESEND_API_KEY=re_xxxxxxxxxxxx
# 2. Adresse qui reçoit les demandes
CONTACT_EMAIL=contact@domaine-dame-de-coeur.fr
# 3. Expéditeur (doit appartenir à un domaine vérifié dans Resend). Facultatif pour un premier test.
# CONTACT_FROM=Domaine la Dame de Cœur <noreply@votre-domaine.fr>
